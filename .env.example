# ── Required: at least one LLM provider key ─────────────────────────────────

# Recommended: OpenRouter (access to all models via one key)
OPENROUTER_API_KEY=sk-or-...
LLM_MODEL=openai/gpt-4o-mini

# Or: direct OpenAI
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# Or: direct Anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-sonnet-4-5

# ── Optional: Tool APIs ──────────────────────────────────────────────────────

# Web search (pick one or more)
EXA_API_KEY=
FIRECRAWL_API_KEY=
PARALLEL_API_KEY=

# Image generation
FAL_KEY=

# Cross-session user modeling
HONCHO_API_KEY=
# Shared Honcho workspace and stable owner peer used by all Hermes profiles.
HERMES_HONCHO_WORKSPACE=hasan
HERMES_HONCHO_OWNER_PEER=hasan

# Optional: route one shared Telegram bot's real topic IDs to specialists.
# IDs must be obtained from Telegram; do not invent them. Example:
# HERMES_TELEGRAM_PROFILE_ROUTES_JSON=[{"name":"marketing-topic","platform":"telegram","chat_id":"123456789","thread_id":"42","profile":"marketing"},{"name":"auditor-topic","platform":"telegram","chat_id":"123456789","thread_id":"43","profile":"auditor"},{"name":"cfo-topic","platform":"telegram","chat_id":"123456789","thread_id":"44","profile":"cfo"}]
HERMES_TELEGRAM_PROFILE_ROUTES_JSON=

# GitHub (higher rate limits for code tools)
GITHUB_TOKEN=

# ── Optional: Browser automation ─────────────────────────────────────────────
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# ── Gateway security ──────────────────────────────────────────────────────────
# Set to false and configure allowlists if you want to restrict access
GATEWAY_ALLOW_ALL_USERS=true

# ── Terminal backend ──────────────────────────────────────────────────────────
# Options: local, docker, modal, ssh
TERMINAL_ENV=local
TERMINAL_TIMEOUT=60
